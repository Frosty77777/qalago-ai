# Server-side only. Never copy these into frontend/ or any VITE_* variable.

# Optional: Gemini grounded generation. Empty = deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: 2GIS Routing API key for real walking routes and walking times.
# Empty = unrouted visit options (walk_minutes/route stay null).
TWOGIS_API_KEY=
ROUTING_TIMEOUT_SECONDS=8
