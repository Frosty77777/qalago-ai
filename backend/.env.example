# Server-side only. Never copy these into frontend/ or any VITE_* variable.
# Local development values; production settings are documented in ../.env.example.

# 2GIS server key: Places, Geocoder, Routing, Public transport. Required for /api/plan.
TWOGIS_API_KEY=
# 2GIS MapGL browser key, served to the UI by /api/config. Public; restrict it by domain.
TWOGIS_MAP_KEY=
ROUTING_TIMEOUT_SECONDS=8

# Google OAuth Web client ID. Empty = sign-in hidden.
GOOGLE_CLIENT_ID=

# Local dev: the Vite dev server origin, plain-http cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Optional: Gemini for intent fallback and the legacy /api/recommend endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
