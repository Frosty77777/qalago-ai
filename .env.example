# Copy to .env (never commit it). Used by docker compose; the backend also reads backend/.env locally.
# Values here are placeholders only.

# --- 2GIS ---------------------------------------------------------------------------------
# Server key: Places API (catalog), Geocoder, Routing API, Public transport API. Secret.
TWOGIS_API_KEY=
# Browser key for the MapGL JS map. Public by design: restrict it to your domains in the
# 2GIS Platform Manager. May be a separate key from TWOGIS_API_KEY (recommended).
TWOGIS_MAP_KEY=
TWOGIS_CITY_SLUG=astana
ROUTING_TIMEOUT_SECONDS=8

# --- Google sign-in -----------------------------------------------------------------------
# OAuth 2.0 Web client ID (public). No client secret is needed for ID-token sign-in.
GOOGLE_CLIENT_ID=

# --- Origins, cookies, sessions -----------------------------------------------------------
# Exact public origin(s) of the UI, comma-separated. Used for CORS and the CSRF Origin check.
CORS_ORIGINS=https://qalago.example.com
# true in production (HTTPS only). Local http://localhost needs false.
COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# --- Limits -------------------------------------------------------------------------------
RATE_LIMIT_PLAN_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10
LOG_LEVEL=INFO

# --- Optional: Gemini (intent fallback and legacy /api/recommend) --------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Compose ------------------------------------------------------------------------------
# Where the web container listens on the host. Keep 127.0.0.1 behind a local reverse proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
