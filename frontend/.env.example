# Only for split local setups where the UI and API run on different origins.
# Leave empty (default): `npm run dev` proxies /api to the backend, and production nginx does the same.
VITE_API_BASE_URL=

# Backend address for the Vite dev proxy (default http://127.0.0.1:8000).
# QALAGO_BACKEND=http://127.0.0.1:8000
